{
  "name": "weavatrix-js",
  "version": "0.3.15",
  "type": "module",
  "description": "JavaScript engine of Weavatrix, the local repository intelligence MCP for AI coding agents: an always-fresh architecture graph with production-first evidence — blast radius, dead code, endpoints, clones, history, Health and architecture safeguards, with honestly labeled precision. The weavatrix npm package now ships the native Rust engine; this fork continues the JavaScript line.",
  "author": "Sergii Ziborov <sergii.ziborov@gmail.com>",
  "license": "MIT",
  "homepage": "https://weavatrix.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sergii-ziborov/weavatrix-js.git"
  },
  "bugs": {
    "url": "https://github.com/sergii-ziborov/weavatrix-js/issues"
  },
  "mcpName": "io.github.sergii-ziborov/weavatrix-js",
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "weavatrix-js": "bin/weavatrix-mcp.mjs"
  },
  "exports": {
    "./mcp-runtime": "./src/mcp-runtime.mjs",
    "./extension-api": "./src/mcp/extension-api.mjs",
    "./extension/local-services": "./src/extension/local-services.mjs",
    "./analysis-kit": "./src/analysis-kit.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "src",
    "skill",
    "scripts/run-agent-task-benchmark.mjs",
    "docs/agent-task-benchmark.md",
    "docs/adr/0001-v0.3-offline-online-split.md",
    "docs/releases/v0.3.15.md",
    "README.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test --test-concurrency=4",
    "benchmark": "node scripts/run-benchmark.mjs",
    "benchmark:quick": "node scripts/run-benchmark.mjs --quick",
    "benchmark:real": "node scripts/run-real-benchmark.mjs",
    "benchmark:real:release": "node scripts/run-real-benchmark.mjs --require-all",
    "benchmark:agent": "node scripts/run-agent-task-benchmark.mjs",
    "benchmark:agent:release": "node scripts/run-agent-task-benchmark.mjs --require-independent",
    "build:mcpb": "node scripts/build-mcpb.mjs",
    "verify:release": "node scripts/verify-release.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "code-graph",
    "impact-analysis",
    "blast-radius",
    "static-analysis",
    "dead-code",
    "dependency-graph",
    "tree-sitter",
    "claude",
    "codex",
    "openai-codex",
    "coding-agents",
    "ai-agents"
  ],
  "dependencies": {
    "tree-sitter-wasms": "0.1.13",
    "typescript": "5.9.3",
    "typescript-language-server": "4.4.1",
    "web-tree-sitter": "0.25.10"
  },
  "devDependencies": {
    "@anthropic-ai/mcpb": "2.1.2"
  },
  "overrides": {
    "tmp": "0.2.7"
  }
}
